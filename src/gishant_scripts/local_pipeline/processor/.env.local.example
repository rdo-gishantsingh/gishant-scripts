# Template for .env.local (the real file is generated by up-local-stack.sh and gitignored).
# Local values only -- never put a prod URL or a prod API key in here.

# Local AYON server. Machine IP so it resolves from every container.
AYON_SERVER_URL=http://10.1.69.24:5000

# Copied from src/gishant_scripts/ayon/ayon-server/.env by up-local-stack.sh.
AYON_API_KEY=<generated-from-ayon-server/.env>

# Must match a version actually installed on the local AYON server.
# 0.3.3 is the version in rdo-ayon-kitsu/package.py (the compose image tag still reads 0.3.2).
AYON_ADDON_NAME=rdo_kitsu
AYON_ADDON_VERSION=0.3.3

# Seconds between Kitsu -> AYON sync batches (processor default is 45).
SYNC_INTERVAL=30


# NOTE: STARTUP_FULL_SYNC is deliberately NOT set here.
# Nothing in the processor reads it -- rdo_kitsu_processor/config.py has no such field,
# so setting it would be a silent no-op. A full sync is triggered per project via:
#   POST {AYON}/api/addons/rdo_kitsu/0.3.3/sync/{project_name}
# which localize_kitsu_addon.py --full-sync does. See README.md.
